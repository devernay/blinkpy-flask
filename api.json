{
  "openapi": "3.0.3",
  "info": {
    "title": "Blink Flask Web Interface API",
    "description": "RESTful API for managing Blink camera systems with live streaming, clip management, and settings",
    "version": "1.0.0",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Main web interface",
        "operationId": "getMainPage",
        "responses": {
          "200": {
            "description": "Main HTML page",
            "content": {
              "text/html": {
                "schema": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "/login": {
      "get": {
        "summary": "Login page",
        "operationId": "getLoginPage",
        "responses": {
          "200": {
            "description": "Login HTML page",
            "content": {
              "text/html": {
                "schema": {"type": "string"}
              }
            }
          }
        }
      },
      "post": {
        "summary": "Process login credentials",
        "operationId": "processLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {"type": "string"},
                  "password": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to 2FA or main page"
          }
        }
      }
    },
    "/2fa": {
      "get": {
        "summary": "2FA verification page",
        "operationId": "get2FAPage",
        "responses": {
          "200": {
            "description": "2FA HTML page",
            "content": {
              "text/html": {
                "schema": {"type": "string"}
              }
            }
          }
        }
      },
      "post": {
        "summary": "Process 2FA verification code",
        "operationId": "process2FA",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["verification_code"],
                "properties": {
                  "verification_code": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to main page or back to 2FA"
          }
        }
      }
    },
    "/logout": {
      "post": {
        "summary": "Logout user and clear session",
        "operationId": "logout",
        "responses": {
          "302": {
            "description": "Redirect to login page"
          }
        }
      }
    },
    "/placeholder": {
      "get": {
        "summary": "Placeholder image for missing thumbnails",
        "operationId": "getPlaceholder",
        "responses": {
          "200": {
            "description": "Placeholder image",
            "content": {
              "image/svg+xml": {
                "schema": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "/api/systems": {
      "get": {
        "summary": "Get list of available Blink systems",
        "operationId": "getSystemList",
        "responses": {
          "200": {
            "description": "List of systems retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "systems": {
                              "type": "array",
                              "items": {"$ref": "#/components/schemas/SystemData"}
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/systems/refresh": {
      "put": {
        "summary": "Manually refresh the Blink system data",
        "operationId": "refreshSystem",
        "responses": {
          "200": {
            "description": "System refresh initiated",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },
    "/api/systems/{network_id}/devices": {
      "get": {
        "summary": "Get devices for a specific Blink system",
        "operationId": "getDevices",
        "parameters": [
          {
            "name": "network_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"},
            "description": "Network ID of the Blink system"
          }
        ],
        "responses": {
          "200": {
            "description": "Devices retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "devices": {
                              "type": "array",
                              "items": {"$ref": "#/components/schemas/DeviceData"}
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/systems/{network_id}/arm": {
      "post": {
        "summary": "Arm or disarm a Blink system",
        "operationId": "armSystem",
        "parameters": [
          {
            "name": "network_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["armed"],
                "properties": {
                  "armed": {"type": "boolean"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Arm status updated",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },
    "/api/cameras/{camera_id}/thumbnail": {
      "get": {
        "summary": "Get camera thumbnail image or timestamp",
        "operationId": "getCameraThumbnail",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "timestamp",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "enum": ["true"]},
            "description": "If 'true', return timestamp instead of image"
          }
        ],
        "responses": {
          "200": {
            "description": "Camera thumbnail image or timestamp",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },

    "/api/cameras/{camera_id}/record": {
      "post": {
        "summary": "Trigger camera to record a new clip",
        "operationId": "triggerCameraRecording",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Recording initiated",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },
    "/api/cameras/{camera_id}/refresh": {
      "put": {
        "summary": "Refresh camera thumbnail",
        "operationId": "refreshCamera",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Thumbnail refresh initiated",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },
    "/api/cameras/{camera_id}/liveview": {
      "get": {
        "summary": "Start live stream for camera",
        "operationId": "getLiveView",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Live stream URLs",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Stop live stream for camera",
        "operationId": "stopLiveView",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Live stream stopped",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },
    "/api/clips": {
      "get": {
        "summary": "Get clips from cloud or local storage",
        "operationId": "getClips",
        "parameters": [
          {
            "name": "storage",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["cloud", "local"],
              "default": "cloud"
            },
            "description": "Storage type"
          }
        ],
        "responses": {
          "200": {
            "description": "Clips retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "clips": {
                              "type": "array",
                              "items": {"$ref": "#/components/schemas/ClipData"}
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/clips/{clip_id}/download": {
      "get": {
        "summary": "Download a specific clip",
        "operationId": "downloadClip",
        "parameters": [
          {
            "name": "clip_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"},
            "description": "Clip ID (cloud ID or local sync~item format)"
          }
        ],
        "responses": {
          "200": {
            "description": "Video clip file",
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/clips/{clip_id}/process": {
      "put": {
        "summary": "Process clip on server (download and generate thumbnail)",
        "operationId": "processClip",
        "parameters": [
          {
            "name": "clip_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Processing initiated",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },
    "/api/clips/{clip_id}/thumbnail": {
      "get": {
        "summary": "Get clip thumbnail image or check availability",
        "operationId": "getClipThumbnail",
        "parameters": [
          {
            "name": "clip_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "check",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "enum": ["true"]},
            "description": "If 'true', check availability instead of returning image"
          }
        ],
        "responses": {
          "200": {
            "description": "Clip thumbnail image or availability status",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },

    "/api/clips/{clip_id}": {
      "delete": {
        "summary": "Delete a clip and its cached files",
        "operationId": "deleteClip",
        "parameters": [
          {
            "name": "clip_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"},
            "description": "Clip ID (cloud ID or local sync~item format)"
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion status",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },
    "/api/cameras/{camera_id}/hls/{filename}": {
      "get": {
        "summary": "Serve HLS playlist and segment files",
        "operationId": "getHLSFile",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {"type": "string"},
            "description": "HLS playlist (.m3u8) or segment (.ts) filename"
          }
        ],
        "responses": {
          "200": {
            "description": "HLS file content",
            "content": {
              "application/vnd.apple.mpegurl": {
                "schema": {"type": "string"}
              },
              "video/mp2t": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Get application configuration",
        "operationId": "getConfig",
        "responses": {
          "200": {
            "description": "Application configuration",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "summary": "Get user settings",
        "operationId": "getSettings",
        "responses": {
          "200": {
            "description": "User settings retrieved",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save user settings",
        "operationId": "saveSettings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "temperatureUnits": {
                    "type": "string",
                    "enum": ["celsius", "fahrenheit"]
                  },
                  "cloudClipRetention": {"type": "string"},
                  "localClipRetention": {"type": "string"},
                  "clipThumbnailSize": {
                    "type": "string",
                    "enum": ["small", "medium", "large"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Settings saved successfully",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },
    "/api/cache": {
      "delete": {
        "summary": "Clear all caches",
        "operationId": "clearCache",
        "responses": {
          "200": {
            "description": "Cache clearing initiated",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "required": ["success", "timestamp"],
        "properties": {
          "success": {"type": "boolean"},
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object",
            "description": "Response data (success only)"
          },
          "error": {
            "type": "string",
            "description": "Error message (failure only)"
          }
        }
      },
      "ClipData": {
        "type": "object",
        "properties": {
          "date": {"type": "string"},
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "string"},
                "created_at": {"type": "string"},
                "thumbnail": {"type": "string"},
                "size": {"type": "integer"},
                "length": {"type": "number"}
              }
            }
          },
          "count": {"type": "integer"}
        }
      },
      "SystemData": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "network_id": {"type": "integer"},
          "armed": {"type": "boolean"},
          "online": {"type": "boolean"}
        }
      },
      "DeviceData": {
        "type": "object",
        "properties": {
          "type": {"type": "string"},
          "name": {"type": "string"},
          "online": {"type": "boolean"},
          "id": {"type": "string"},
          "thumbnail": {"type": "string"},
          "battery": {"type": "string"},
          "temperature": {"type": "integer"},
          "wifi_strength": {"type": "integer"}
        }
      }
    }
  }
}
