{
  "openapi": "3.0.3",
  "info": {
    "title": "Blink Flask Web Interface API",
    "description": "RESTful API for managing Blink camera systems with live streaming, clip management, and settings",
    "version": "2.0.0",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Main page",
        "description": "Redirect to login if not authenticated, otherwise show main interface",
        "responses": {
          "200": {
            "description": "Main interface or login redirect"
          }
        }
      }
    },
    "/api/systems": {
      "get": {
        "summary": "List all Blink systems",
        "description": "Get list of available Blink sync modules and their network information",
        "responses": {
          "200": {
            "description": "List of systems",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean"},
                    "systems": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "network_id": {"type": "string"},
                          "name": {"type": "string"},
                          "armed": {"type": "boolean"},
                          "status": {"type": "string"}
                        }
                      }
                    },
                    "timestamp": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/systems/{network_id}": {
      "get": {
        "summary": "Get system details",
        "description": "Get detailed information about a specific Blink system",
        "parameters": [
          {
            "name": "network_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "System details"
          },
          "404": {
            "description": "System not found"
          }
        }
      },
      "put": {
        "summary": "Update system",
        "description": "Update system settings (arm/disarm)",
        "parameters": [
          {
            "name": "network_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "armed": {"type": "boolean"}
                },
                "required": ["armed"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "System updated successfully"
          },
          "404": {
            "description": "System not found"
          }
        }
      }
    },
    "/api/systems/{network_id}/devices": {
      "get": {
        "summary": "Get system devices",
        "description": "Get all devices (cameras, sync modules) for a specific system",
        "parameters": [
          {
            "name": "network_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "List of devices"
          },
          "404": {
            "description": "System not found"
          }
        }
      }
    },
    "/api/systems/cache": {
      "delete": {
        "summary": "Clear systems cache",
        "description": "Clear cached system information to force refresh",
        "responses": {
          "200": {
            "description": "Systems cache cleared"
          }
        }
      }
    },
    "/api/cameras": {
      "get": {
        "summary": "List all cameras",
        "description": "Get list of all available cameras across all systems",
        "responses": {
          "200": {
            "description": "List of cameras",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean"},
                    "cameras": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {"type": "string"},
                          "name": {"type": "string"},
                          "network_id": {"type": "string"},
                          "enabled": {"type": "boolean"},
                          "status": {"type": "string"}
                        }
                      }
                    },
                    "timestamp": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/cameras/{camera_id}": {
      "get": {
        "summary": "Get camera details",
        "description": "Get detailed information about a specific camera",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Camera details"
          },
          "404": {
            "description": "Camera not found"
          }
        }
      }
    },
    "/api/cameras/{camera_id}/thumbnail": {
      "get": {
        "summary": "Get camera thumbnail",
        "description": "Get current thumbnail image for a camera",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "timestamp",
            "in": "query",
            "required": false,
            "description": "Return timestamp instead of image",
            "schema": {"type": "boolean"}
          }
        ],
        "responses": {
          "200": {
            "description": "Thumbnail image or timestamp"
          },
          "404": {
            "description": "Camera or thumbnail not found"
          }
        }
      },
      "delete": {
        "summary": "Refresh camera thumbnail",
        "description": "Clear thumbnail cache and trigger refresh from camera",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Thumbnail refresh initiated"
          },
          "404": {
            "description": "Camera not found"
          }
        }
      }
    },
    "/api/cameras/{camera_id}/record": {
      "post": {
        "summary": "Start recording",
        "description": "Start recording a clip on the camera",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Recording started"
          },
          "404": {
            "description": "Camera not found"
          }
        }
      }
    },
    "/api/cameras/{camera_id}/streams": {
      "post": {
        "summary": "Start live stream",
        "description": "Start live streaming from camera using TCP to HLS transcoding",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Live stream started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean"},
                    "stream_url": {"type": "string"},
                    "playlist_url": {"type": "string"}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Camera not found"
          }
        }
      },
      "delete": {
        "summary": "Stop live stream",
        "description": "Stop active live stream for camera",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Live stream stopped"
          },
          "404": {
            "description": "Camera not found"
          }
        }
      }
    },
    "/api/cameras/{camera_id}/streams/{filename}": {
      "get": {
        "summary": "Get HLS stream segments",
        "description": "Get HLS playlist or video segments for live streaming",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "HLS content"
          },
          "404": {
            "description": "Stream or file not found"
          }
        }
      }
    },
    "/api/clips": {
      "get": {
        "summary": "List clips",
        "description": "Get list of clips from cloud or local storage",
        "parameters": [
          {
            "name": "storage",
            "in": "query",
            "required": false,
            "description": "Storage type to filter by",
            "schema": {
              "type": "string",
              "enum": ["cloud", "local"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of clips",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean"},
                    "clips": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {"type": "string"},
                          "name": {"type": "string"},
                          "created_at": {"type": "string", "format": "date-time"},
                          "size": {"type": "integer"},
                          "camera_name": {"type": "string"},
                          "storage_type": {"type": "string"}
                        }
                      }
                    },
                    "timestamp": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/clips/{clip_id}": {
      "delete": {
        "summary": "Delete clip",
        "description": "Delete a clip from storage",
        "parameters": [
          {
            "name": "clip_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Clip deleted"
          },
          "404": {
            "description": "Clip not found"
          }
        }
      }
    },
    "/api/clips/{clip_id}/download": {
      "get": {
        "summary": "Download clip",
        "description": "Download clip file",
        "parameters": [
          {
            "name": "clip_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Clip file",
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Clip not found"
          }
        }
      }
    },
    "/api/clips/{clip_id}/thumbnail": {
      "get": {
        "summary": "Get clip thumbnail",
        "description": "Get thumbnail image for a clip",
        "parameters": [
          {
            "name": "clip_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "check",
            "in": "query",
            "required": false,
            "description": "Check thumbnail availability without generating",
            "schema": {"type": "boolean"}
          }
        ],
        "responses": {
          "200": {
            "description": "Thumbnail image or availability status"
          },
          "404": {
            "description": "Clip or thumbnail not found"
          }
        }
      },
      "post": {
        "summary": "Generate clip thumbnail",
        "description": "Generate thumbnail for a clip",
        "parameters": [
          {
            "name": "clip_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Thumbnail generation initiated"
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Get application configuration",
        "description": "Get current application configuration and status",
        "responses": {
          "200": {
            "description": "Application configuration",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean"},
                    "config": {
                      "type": "object",
                      "properties": {
                        "thumbnail_cache_size": {"type": "integer"},
                        "clips_cache_size": {"type": "integer"},
                        "thumbnail_processing_display_time": {"type": "integer"},
                        "thumbnail_error_display_time": {"type": "integer"},
                        "clip_processing_display_time": {"type": "integer"}
                      }
                    },
                    "timestamp": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "summary": "Get user settings",
        "description": "Get current user preferences and settings",
        "responses": {
          "200": {
            "description": "User settings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean"},
                    "settings": {
                      "type": "object",
                      "properties": {
                        "temperature_unit": {
                          "type": "string",
                          "enum": ["celsius", "fahrenheit"]
                        },
                        "cloud_clip_retention_days": {"type": "integer"},
                        "local_clip_retention_days": {"type": "integer"},
                        "thumbnail_size": {
                          "type": "string",
                          "enum": ["small", "medium", "large"]
                        }
                      }
                    },
                    "timestamp": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update user settings",
        "description": "Update user preferences and settings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "temperature_unit": {
                    "type": "string",
                    "enum": ["celsius", "fahrenheit"]
                  },
                  "cloud_clip_retention_days": {"type": "integer"},
                  "local_clip_retention_days": {"type": "integer"},
                  "thumbnail_size": {
                    "type": "string",
                    "enum": ["small", "medium", "large"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Settings updated successfully"
          }
        }
      }
    },
    "/api/cache": {
      "delete": {
        "summary": "Clear all caches",
        "description": "Clear all application caches (thumbnails, clips, systems)",
        "responses": {
          "200": {
            "description": "All caches cleared"
          }
        }
      }
    },
    "/api/cache/thumbnails": {
      "delete": {
        "summary": "Clear thumbnail cache",
        "description": "Clear only the thumbnail cache",
        "responses": {
          "200": {
            "description": "Thumbnail cache cleared"
          }
        }
      }
    },
    "/api/cache/clips": {
      "delete": {
        "summary": "Clear clips cache",
        "description": "Clear only the clips cache",
        "responses": {
          "200": {
            "description": "Clips cache cleared"
          }
        }
      }
    },
    "/logout": {
      "post": {
        "summary": "Logout",
        "description": "Logout and clear credentials",
        "responses": {
          "200": {
            "description": "Logged out successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": {"type": "boolean"},
          "timestamp": {"type": "string", "format": "date-time"}
        },
        "required": ["success", "timestamp"]
      },
      "ErrorResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/ApiResponse"},
          {
            "type": "object",
            "properties": {
              "error": {"type": "string"}
            },
            "required": ["error"]
          }
        ]
      }
    }
  }
}
