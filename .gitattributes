# Git attributes for Blink Flask application

# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py text
*.md text
*.txt text
*.json text
*.html text
*.css text
*.js text
*.ini text
*.toml text
*.yml text
*.yaml text
*.m3u8 text

# Declare files that will always have LF line endings on checkout
*.sh text eol=lf

# Denote all files that are truly binary and should not be modified
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.mp4 binary
*.ts binary
*.pyc binary

# Generated files
htmlcov/* linguist-generated
__pycache__/* linguist-generated